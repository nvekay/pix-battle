* text=auto
# DataHash считается по байтам файлов данных: перевод строк не должен зависеть от машины.
Assets/StreamingAssets/Data/** text eol=lf
*.json text eol=lf
*.cs text eol=lf diff=csharp
*.shader text eol=lf
*.uxml text eol=lf
*.uss text eol=lf
*.tss text eol=lf
*.md text eol=lf
*.unity text eol=lf merge=unityyamlmerge
*.prefab text eol=lf merge=unityyamlmerge
*.asset text eol=lf merge=unityyamlmerge
*.mat text eol=lf merge=unityyamlmerge
*.meta text eol=lf
*.png binary
*.jpg binary
*.fbx binary
