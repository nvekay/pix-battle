/* Только тап: никаких :hover-подсказок. Все цели нажатия ≥ 44×44 единиц PanelSettings. */
.root {
    flex-grow: 1;
    flex-direction: column;
    justify-content: space-between;
}
.bar {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    padding: 4px 8px;
    background-color: rgba(10, 14, 18, 0.78);
}
.top-bar { min-height: 44px; }
.bottom-bar { min-height: 52px; }
.map-area { flex-grow: 1; }
.status {
    color: rgb(230, 230, 230);
    font-size: 16px;
    -unity-text-align: middle-left;
}
.btn {
    min-width: 44px;
    min-height: 44px;
    margin: 4px;
    padding: 0 12px;
    font-size: 16px;
}
.btn.active {
    background-color: rgb(70, 120, 180);
    color: rgb(255, 255, 255);
}
.seed {
    min-height: 44px;
    min-width: 200px;
    margin: 4px;
    font-size: 16px;
}
.seed > .unity-base-text-field__input {
    min-height: 44px;
    min-width: 120px;
}
.pixel-info {
    position: absolute;
    padding: 8px 12px;
    min-height: 44px;
    background-color: rgba(10, 14, 18, 0.9);
    color: rgb(240, 240, 240);
    font-size: 16px;
    border-radius: 4px;
}
.toast {
    position: absolute;
    bottom: 64px;
    left: 8px;
    right: 8px;
    padding: 8px 12px;
    background-color: rgba(10, 14, 18, 0.9);
    color: rgb(240, 240, 240);
    font-size: 14px;
    white-space: normal;
}
.hidden { display: none; }
.seed > Label {
    color: rgb(230, 230, 230);
    min-width: 40px;
    -unity-text-align: middle-left;
}
