/* UI под ПК (спека 01b §10): мышь, подсказки по наведению разрешены, причина отказа видна и по клику. */
.root {
    flex-grow: 1;
    flex-direction: column;
}
.bar {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    padding: 4px 8px;
    background-color: rgba(10, 14, 18, 0.82);
}
.top-bar { min-height: 52px; }
.bottom-bar { min-height: 60px; justify-content: center; }
.map-area { flex-grow: 1; }
.spacer { flex-grow: 1; }
.hud {
    color: rgb(235, 235, 235);
    font-size: 18px;
    margin: 0 10px;
    -unity-text-align: middle-left;
}
.status {
    color: rgb(200, 200, 200);
    font-size: 14px;
    -unity-text-align: middle-left;
    margin-right: 8px;
}
.btn {
    min-width: 44px;
    min-height: 44px;
    margin: 4px;
    padding: 0 12px;
    font-size: 16px;
}
.btn.active {
    background-color: rgb(70, 120, 180);
    color: rgb(255, 255, 255);
}
.btn.disabled-look {
    color: rgb(140, 140, 140);
    background-color: rgb(70, 72, 76);
}
.action {
    min-width: 180px;
    min-height: 52px;
    font-size: 18px;
}
.btn-confirm {
    background-color: rgb(70, 140, 90);
    color: rgb(255, 255, 255);
}
.mode-bar { min-height: 52px; justify-content: center; }
.mode-text {
    color: rgb(240, 240, 240);
    font-size: 17px;
    margin-right: 12px;
}
.seed {
    min-height: 44px;
    min-width: 200px;
    margin: 4px;
    font-size: 16px;
}
.seed > .unity-base-text-field__input {
    min-height: 44px;
    min-width: 120px;
}
.seed > Label {
    color: rgb(230, 230, 230);
    min-width: 40px;
    -unity-text-align: middle-left;
}
.panel {
    position: absolute;
    padding: 8px 12px;
    min-height: 44px;
    max-width: 520px;
    background-color: rgba(10, 14, 18, 0.92);
    color: rgb(240, 240, 240);
    font-size: 16px;
    border-radius: 4px;
    white-space: normal;
}
.tip {
    bottom: 240px;
    left: 0;
    right: 0;
    margin: 0 auto;
    align-self: center;
    -unity-text-align: middle-center;
    background-color: rgba(120, 60, 40, 0.95);
}
.toast {
    position: absolute;
    top: 64px;
    left: 30%;
    right: 30%;
    padding: 8px 12px;
    background-color: rgba(10, 14, 18, 0.9);
    color: rgb(240, 240, 240);
    font-size: 17px;
    -unity-text-align: middle-center;
    white-space: normal;
}
.end-screen {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.6);
    align-items: center;
    justify-content: center;
}
.end-box {
    padding: 24px 32px;
    background-color: rgb(20, 26, 32);
    border-radius: 6px;
    align-items: center;
}
.end-title { font-size: 36px; color: rgb(255, 255, 255); -unity-font-style: bold; }
.end-text { font-size: 18px; color: rgb(220, 220, 220); margin-top: 8px; }
.end-buttons { flex-direction: row; margin-top: 16px; }
.hidden { display: none; }

/* ---------- 01b: панели фронтов и соединений ---------- */
.markers { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.marker {
    position: absolute;
    padding: 1px 5px;
    font-size: 14px;
    color: rgb(255, 255, 255);
    background-color: rgba(20, 40, 80, 0.9);
    border-width: 1px;
    border-color: rgb(255, 255, 255);
    border-radius: 3px;
    -unity-font-style: bold;
}
.marker.attack { background-color: rgba(150, 40, 30, 0.92); }
.marker.empty { background-color: rgba(120, 110, 30, 0.92); color: rgb(255, 245, 200); }
.side-panel {
    position: absolute;
    right: 8px;
    top: 64px;
    width: 450px;
    padding: 6px;
    background-color: rgba(10, 14, 18, 0.88);
    border-radius: 4px;
}
.panel-title { color: rgb(255, 255, 255); font-size: 18px; -unity-font-style: bold; margin: 2px 6px 6px 2px; -unity-text-align: middle-left; }
.hint { color: rgb(170, 175, 180); font-size: 14px; margin: 2px 6px; -unity-text-align: middle-left; white-space: normal; }
.front-row {
    flex-direction: row;
    align-items: center;
    min-height: 40px;
    padding: 2px 4px;
    margin-bottom: 3px;
    background-color: rgba(40, 46, 52, 0.9);
    border-radius: 3px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
}
.front-row.selected { border-color: rgb(255, 255, 255); }
.front-row.drop-target { border-color: rgb(110, 170, 240); }
.swatch { width: 14px; height: 28px; margin-right: 6px; border-radius: 2px; }
.front-name { color: rgb(240, 240, 240); font-size: 15px; width: 100px; -unity-text-align: middle-left; }
.front-cell { color: rgb(215, 215, 215); font-size: 14px; margin: 0 4px; -unity-text-align: middle-left; }
.terrain-strip { flex-direction: row; width: 54px; min-width: 54px; height: 10px; margin: 0 4px; flex-shrink: 0; }
.terrain-plain { background-color: rgb(140, 190, 110); }
.terrain-hills { background-color: rgb(180, 150, 90); }
.terrain-mountains { background-color: rgb(140, 140, 150); }
.order-icon { font-size: 14px; width: 70px; -unity-text-align: middle-left; }
.order-attack { color: rgb(255, 130, 110); }
.order-hold { color: rgb(150, 200, 255); }
.order-empty { color: rgb(240, 210, 90); }
.bottom-panel {
    position: absolute;
    left: 8px;
    right: 466px;
    bottom: 8px;
    padding: 6px;
    background-color: rgba(10, 14, 18, 0.88);
    border-radius: 4px;
}
.formations-bar { flex-direction: row; align-items: center; flex-wrap: wrap; }
.formations-list { min-height: 170px; }
.formations-list > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container { flex-direction: row; }
.card {
    width: 210px;
    padding: 6px;
    margin: 4px;
    background-color: rgba(40, 46, 52, 0.95);
    border-radius: 4px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
}
.card.selected { border-color: rgb(255, 255, 255); }
.card-title { color: rgb(255, 255, 255); font-size: 16px; -unity-font-style: bold; }
.card-text { color: rgb(215, 215, 215); font-size: 14px; white-space: normal; }
.bar-bg { height: 8px; margin: 4px 0; background-color: rgb(60, 64, 70); }
.bar-fill { height: 8px; background-color: rgb(110, 190, 110); }
.bar-fill.low { background-color: rgb(220, 110, 80); }
.card-row { flex-direction: row; }
.card .btn { min-height: 32px; min-width: 32px; font-size: 14px; padding: 0 6px; margin: 2px; flex-grow: 1; }
.front-plate { left: 16px; top: 600px; max-width: 1000px; }
