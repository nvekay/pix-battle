/* Спека 02a §9: стиль brief-02. Панель #181D27 92%, рамка 3 px #404A5C, прямые углы, без градиентов, отступы кратны 4.
   Переменные: акцент (--accent) — цвет своей нации, ставится кодом на .root. */
:root {
    --panel: rgba(24, 29, 39, 0.92);
    --edge: rgb(64, 74, 92);
    --edge-hi: rgb(98, 110, 132);
    --text: rgb(232, 230, 224);
    --dim: rgb(154, 160, 172);
    --gold: rgb(244, 196, 72);
    --bad: rgb(232, 92, 80);
    --good: rgb(120, 210, 110);
    --accent: rgb(63, 102, 217);
}

.root {
    -unity-font-definition: url("Fonts/Tiny5.asset");
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    color: var(--text);
    font-size: 20px;
}
.map-area { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.hidden { display: none; }

.text-20 { font-size: 20px; color: var(--text); margin: 0; padding: 0; }
.text-30 { font-size: 30px; color: var(--text); margin: 0; padding: 0; -unity-font-style: bold; }
.caption { font-size: 20px; color: var(--dim); margin: 0; padding: 0; }
.dim { color: var(--dim); }
.gold { color: var(--gold); }
.bad { color: var(--bad); }
.good { color: var(--good); }

.panel {
    background-color: var(--panel);
    border-width: 3px;
    border-color: var(--edge);
    border-top-color: var(--edge-hi);
    border-radius: 0;
    padding: 8px 12px;
}

.icon {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}
.icon.small { width: 16px; height: 16px; }

/* ---------- кнопки ---------- */
.btn {
    background-color: var(--panel);
    border-width: 3px;
    border-color: var(--edge);
    border-top-color: var(--edge-hi);
    border-radius: 0;
    color: var(--text);
    font-size: 20px;
    min-height: 40px;
    min-width: 40px;
    margin: 0 4px;
    padding: 0 8px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
}
.btn:hover { border-color: var(--accent); }
.btn:active { background-color: rgba(63, 102, 217, 0.35); }
.btn.active { background-color: rgba(63, 102, 217, 0.35); border-color: var(--accent); }
.btn.disabled-look { color: var(--dim); background-color: rgba(30, 34, 44, 0.92); }
.btn > .icon { margin-right: 4px; }

/* ---------- карточка нации ---------- */
.nation-card {
    position: absolute;
    left: 16px; top: 16px;
    width: 320px; height: 76px;
    flex-direction: row;
    align-items: center;
}
.nation-swatch {
    width: 48px; height: 40px;
    border-width: 3px;
    border-color: rgb(255, 255, 255);
    margin-right: 12px;
}
.nation-names { flex-grow: 1; }
.you-badge {
    font-size: 20px;
    -unity-font-style: bold;
    padding: 2px 8px;
    border-width: 3px;
    border-color: var(--accent);
    color: var(--text);
}

/* ---------- HUD ---------- */
.hud {
    position: absolute;
    top: 16px; left: 352px; right: 360px;
    height: 76px;
    flex-direction: row;
    align-items: center;
    justify-content: space-around;
    padding: 4px 12px;
}
.hud-group { flex-direction: row; align-items: center; margin: 0 8px; }
.hud-group > .icon { margin-right: 8px; }
.hud-text { justify-content: center; }
.hud-values { flex-direction: row; align-items: flex-end; }
.hud-values > Label { margin-right: 8px; }
.hud-territory { flex-grow: 1; max-width: 460px; }
.territory-text { flex-grow: 1; }
.goal-caption { margin-left: auto; }
.land-bar {
    height: 20px;
    background-color: rgb(40, 46, 58);
    border-width: 2px;
    border-color: rgb(12, 14, 18);
    flex-direction: row;
    margin-top: 2px;
}
.land-fill { height: 100%; background-color: var(--accent); }
.land-share { position: absolute; left: 4px; top: -3px; font-size: 20px; color: var(--text); -unity-font-style: bold; -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(12, 14, 18); }
.land-goal { position: absolute; width: 4px; top: -6px; bottom: -6px; background-color: var(--gold); }
.land-leader {
    position: absolute;
    top: -12px;
    width: 12px; height: 12px;
    rotate: 45deg;
    border-width: 2px;
    border-color: rgb(12, 14, 18);
}
.leader-label { font-size: 20px; white-space: nowrap; margin-left: 12px; }

/* ---------- скорость ---------- */
.speed {
    position: absolute;
    top: 16px; right: 16px;
    height: 76px;
    flex-direction: row;
    align-items: center;
    padding: 4px 8px;
}
.speed-btn { width: 56px; height: 52px; margin: 0 2px; font-size: 24px; }
.speed-btn.gear { width: 44px; font-size: 20px; }
.debug-panel {
    position: absolute;
    top: 100px; right: 16px;
    max-width: 900px;
}
.debug-row { flex-direction: row; align-items: center; margin-top: 4px; }
.status { font-size: 20px; color: var(--dim); }
.seed { min-width: 200px; margin: 0 4px; font-size: 20px; }
.seed > Label { color: var(--text); min-width: 40px; }

/* ---------- фронты ---------- */
.fronts-panel {
    position: absolute;
    top: 108px; right: 16px;
    width: 400px;
}
.panel-title { margin-bottom: 8px; }
.front-row {
    flex-direction: column;
    padding: 4px 8px;
    margin-bottom: 4px;
    background-color: rgb(36, 44, 58);
    border-width: 2px;
    border-color: rgb(12, 14, 18);
}
.front-row:hover { border-color: var(--accent); }
.front-row.selected { border-color: var(--gold); border-width: 3px; }
.front-row.drop-target { border-color: var(--accent); }
.front-top { flex-direction: row; align-items: center; height: 32px; }
.front-name { font-size: 20px; color: var(--text); -unity-font-style: bold; flex-grow: 1; margin-left: 8px; }
.front-order { width: 32px; height: 32px; }
.front-verdict { font-size: 20px; margin-left: 8px; }
.swatch { width: 24px; height: 24px; border-width: 2px; border-color: rgb(12, 14, 18); }
.front-bottom { flex-direction: row; align-items: center; margin-top: 4px; }
.pressure {
    flex-direction: row;
    flex-grow: 1;
    height: 12px;
    border-width: 2px;
    border-color: rgb(10, 10, 14);
}
.pressure > VisualElement { height: 100%; }
.terrain-strip {
    flex-direction: row;
    width: 80px;
    height: 12px;
    margin-left: 8px;
    border-width: 2px;
    border-color: rgb(10, 10, 14);
}
.terrain-plain { background-color: rgb(118, 176, 72); }
.terrain-hills { background-color: rgb(140, 118, 70); }
.terrain-mountains { background-color: rgb(180, 176, 172); }

/* ---------- плашка фронта ---------- */
.front-plate {
    position: absolute;
    width: 420px;
    border-color: var(--gold);
    padding: 8px 12px 12px 12px;
}
.plate-row { flex-direction: row; align-items: center; margin-top: 4px; }
.plate-row > .icon { width: 32px; height: 32px; margin-right: 4px; }
.plate-row > Label { margin-right: 8px; flex-shrink: 1; white-space: normal; }
.plate-verdict { margin-top: 8px; -unity-font-style: bold; white-space: normal; }
.plate-pointer {
    position: absolute;
    width: 18px; height: 18px;
    bottom: -12px;
    left: 40px;
    rotate: 45deg;
    background-color: rgb(24, 29, 39);
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-color: var(--gold);
}

/* ---------- значки на карте ---------- */
.capital-star { position: absolute; }
.country-label {
    position: absolute;
    color: rgb(255, 255, 255);
    font-size: 30px;
    text-shadow: 2px 2px 0 rgb(20, 18, 26);
    white-space: nowrap;
    padding: 0;
    margin: 0;
}
.hq-marker {
    position: absolute;
    flex-direction: row;
    align-items: center;
    padding: 0 4px 0 0;
    background-color: rgba(24, 29, 39, 0.85);
    border-width: 2px;
    border-color: rgb(12, 14, 18);
}
.hq-marker > Label { font-size: 20px; color: var(--text); -unity-font-style: bold; margin: 0; padding: 0; }
.hq-marker.attack { border-color: var(--bad); }
.hq-marker.empty { border-color: var(--gold); background-color: rgba(24, 29, 39, 0.6); }
.hq-marker { flex-direction: column; align-items: stretch; padding: 0 4px 2px 0; }
.hq-marker-top { flex-direction: row; align-items: center; }
.hq-org { height: 4px; margin-left: 4px; background-color: rgb(40, 46, 58); }
.hq-org-fill { height: 100%; background-color: var(--gold); }
.hq-org-fill.exhausted { background-color: var(--dim); }
.hq-marker.tired { border-color: var(--dim); }

/* ---------- соединения ---------- */
.formations-panel {
    position: absolute;
    left: 392px; right: 16px; bottom: 16px;
    max-width: 1140px;
    padding: 8px 12px;
}
.formations-bar { flex-direction: row; align-items: center; margin-bottom: 8px; }
.formations-bar > .panel-title { margin: 0 12px 0 0; }
.assign-hint { margin-left: 8px; flex-shrink: 1; white-space: normal; }
.formations-list { height: 176px; }
.formations-list .unity-scroll-view__content-container { flex-direction: row; align-items: flex-start; }
/* Дивизии (01c §9): группы слева направо, в группе плитки 72×56 по две в столбец. */
.div-group { margin-right: 12px; }
.div-group-head { font-size: 20px; color: var(--dim); margin: 0 0 4px 0; padding: 0; height: 24px; white-space: nowrap; }
.div-group-head:hover { color: var(--text); }
.div-group-body { flex-direction: column; flex-wrap: wrap; height: 128px; align-content: flex-start; }
.div-tile {
    width: 72px; height: 56px;
    margin: 0 4px 4px 0;
    padding: 2px 4px;
    background-color: rgb(36, 44, 58);
    border-width: 2px;
    border-color: rgb(12, 14, 18);
}
.div-tile:hover { border-color: var(--edge-hi); }
.div-tile.selected { border-color: var(--accent); border-width: 3px; background-color: rgb(40, 52, 80); }
.div-tile.training { background-color: rgb(30, 34, 44); }
.div-tile-head { flex-direction: row; align-items: center; height: 24px; }
.div-tile-icon { width: 16px; height: 16px; }
.div-tile-num { font-size: 20px; color: var(--text); margin: 0 0 0 2px; padding: 0; flex-grow: 1; }
.div-tile-pause { width: 16px; height: 16px; }
.div-tile-timer { font-size: 20px; color: var(--gold); margin: 0; padding: 0; -unity-text-align: middle-right; }
.div-bar { height: 6px; margin-top: 4px; background-color: rgb(40, 46, 58); }
.div-bar-fill { height: 100%; }
.div-bar-str { background-color: var(--good); }
.div-bar-str.low { background-color: var(--bad); }
.div-bar-org { background-color: var(--gold); }
.div-bar-org.exhausted { background-color: var(--dim); }
.select-band { position: absolute; border-width: 2px; border-color: var(--accent); background-color: rgba(63, 102, 217, 0.15); }
.order-toggle { flex-direction: row; margin-left: 8px; }
.order-btn { width: 32px; height: 32px; min-height: 32px; padding: 0; margin: 0 0 0 2px; }
.order-btn > .icon { margin: 0; width: 24px; height: 24px; }
.card {
    width: 220px;
    height: 164px;
    margin-right: 8px;
    padding: 4px 8px;
    background-color: rgb(36, 44, 58);
    border-width: 2px;
    border-color: rgb(12, 14, 18);
}
.card:hover { border-color: var(--edge-hi); }
.card.selected { border-color: var(--accent); border-width: 3px; background-color: rgb(40, 52, 80); }
.card-head { flex-direction: row; align-items: center; justify-content: space-between; height: 32px; }
.card-comp { flex-direction: row; align-items: center; }
.card-comp > .icon { width: 24px; height: 24px; }
.card-comp > Label { font-size: 20px; margin: 0 4px 0 0; padding: 0; }
.bar-bg { height: 8px; background-color: rgb(40, 46, 58); margin: 4px 0; border-width: 1px; border-color: rgb(12, 14, 18); }
.bar-fill { height: 100%; background-color: var(--good); }
.bar-fill.low { background-color: var(--bad); }
.card-where { font-size: 20px; color: var(--dim); margin: 0; padding: 0; overflow: hidden; white-space: nowrap; }
.card-row { flex-direction: row; margin-top: 4px; }
.card-row > .btn { flex-grow: 1; flex-basis: 0; min-height: 32px; height: 32px; margin: 0 2px; padding: 0 2px; font-size: 20px; }
.card-row > .btn > .icon { width: 24px; height: 24px; }

/* ---------- сводка ---------- */
.feed {
    position: absolute;
    left: 16px; bottom: 16px;
    width: 360px;
    flex-direction: column-reverse;
}
.feed-card {
    height: 64px;
    margin-top: 8px;
    padding: 4px 8px 4px 16px;
    justify-content: center;
}
.feed-stripe { position: absolute; left: 0; top: 0; bottom: 0; width: 8px; }
.feed-head { font-size: 20px; -unity-font-style: bold; margin: 0; padding: 0; }
.feed-body { font-size: 20px; color: var(--text); margin: 0; padding: 0; white-space: nowrap; overflow: hidden; }
.feed-card.urgent { border-color: var(--bad); }
.feed-card.urgent .feed-stripe { background-color: var(--bad); }
.feed-card.urgent .feed-head { color: var(--bad); }
.feed-card.loss { border-color: rgb(244, 170, 60); }
.feed-card.loss .feed-stripe { background-color: rgb(244, 170, 60); }
.feed-card.loss .feed-head { color: rgb(244, 170, 60); }
.feed-card.report .feed-stripe { background-color: rgb(200, 204, 214); }
.feed-card.report .feed-head { color: rgb(200, 204, 214); }

/* ---------- подсказки ---------- */
.tip {
    position: absolute;
    bottom: 236px; left: 392px;
    max-width: 640px;
    border-color: var(--gold);
    white-space: normal;
}
.pixel-info {
    position: absolute;
    top: 100px; left: 16px;
    max-width: 420px;
    white-space: normal;
}
.toast {
    position: absolute;
    top: 100px;
    left: 30%; right: 30%;
    -unity-text-align: middle-center;
    white-space: normal;
}

.hover {
    position: absolute;
    max-width: 520px;
    white-space: normal;
    font-size: 20px;
    border-color: var(--edge-hi);
}

/* ---------- экран конца ---------- */
.end-screen {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
    align-items: center;
    justify-content: center;
}
.end-box { padding: 24px 32px; align-items: center; }
.end-title { font-size: 60px; color: var(--text); -unity-font-style: bold; margin-bottom: 8px; }
.end-buttons { flex-direction: row; margin-top: 16px; }
.end-buttons > .btn { padding: 0 16px; height: 48px; }
